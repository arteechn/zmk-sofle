#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10
#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  //  600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    behaviors {
        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <900>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <1>;      // 0
            time-to-max-speed-ms = <400>;      // 500
            delay-ms = <0>;                   //   10
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    scroll_keypress: scroll_keypress {
        compatible = "zmk,behavior-sensor-rotate-var";
        label = "SCROLL_KEYPRESS";
        #sensor-binding-cells = <2>;
        bindings = <&kp>, <&kp>;
    };

    combos {
        compatible = "zmk,combos";

        return {
            bindings = <&kp RETURN>;
            key-positions = <34 35 36>;
        };

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <14 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp TILDE             &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4      &kp N5       &kp LG(LS(S))  &kp NUMBER_6   &kp N7            &kp N8          &kp N9        &kp N0             &kp LC(LEFT_SHIFT)
&kp BACKSPACE         &kp Q           &kp W         &kp E           &kp R             &kp T        &kp LS(LG(T))  &kp Y          &kp U             &kp I           &kp O         &kp P              &kp RC(BACKSPACE)
&mt LEFT_CONTROL TAB  &mt LEFT_GUI A  &kp S         &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G        &to 3          &kp H          &mt LEFT_SHIFT J  &mt LEFT_ALT K  &kp L         &mt LEFT_GUI SEMI  &mt LEFT_CONTROL APOS
&kp RIGHT_ALT         &kp Z           &kp X         &kp C           &kp V             &kp B        &to 4          &kp N          &kp M             &kp COMMA       &kp DOT       &kp FSLH           &kp BACKSLASH
&kp C_PLAY_PAUSE      &kp LCTRL       &kp LEFT_ALT  &kp CAPSLOCK    &mo 1             &kp SPACE    &trans         &kp BACKSPACE  &mo 2             &kp CAPSLOCK    &kp LEFT_ALT  &kp LEFT_CONTROL
            >;

            sensor-bindings = <&scroll_keypress LC(RIGHT) LC(LEFT)>;
            display-name = "Write";
        };

        Movement {
            bindings = <
&kp LG(NUMBER_1)  &trans     &trans          &trans          &trans           &trans    &trans  &trans      &trans                    &trans  &trans  &trans  &kp LG(DELETE)
&kp LG(NUMBER_2)  &trans     &trans          &kp UP_ARROW    &trans           &trans    &trans  &trans      &trans                    &trans  &trans  &trans  &kp LA(DELETE)
&kp LG(NUMBER_3)  &trans     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans    &trans  &kp PG_UP   &mt LEFT_SHIFT PAGE_DOWN  &trans  &trans  &trans  &trans
&kp LG(NUMBER_4)  &kp LC(Z)  &kp LC(X)       &kp LC(C)       &kp LC(V)        &trans    &trans  &kp HOME    &kp END                   &trans  &trans  &trans  &trans
&kp C_MUTE        &trans     &trans          &trans          &trans           &trans    &trans  &kp DELETE  &trans                    &trans  &trans  &trans
            >;

            display-name = "Movement";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        NumsSymbs {
            bindings = <
&trans    &trans              &trans        &trans              &trans                   &trans         &trans  &trans                &trans                        &trans                   &trans            &trans              &trans
&trans    &kp NUMBER_1        &kp NUMBER_2  &kp NUMBER_3        &kp NUMBER_4             &kp N5         &trans  &kp NUMBER_6          &kp N7                        &kp N8                   &kp N9            &kp N0              &trans
&trans    &mt LEFT_GUI GRAVE  &kp MINUS     &mt LEFT_ALT EQUAL  &mt LEFT_SHIFT ASTERISK  &kp CARET      &trans  &kp LEFT_BRACKET      &mt LEFT_SHIFT RIGHT_BRACKET  &mt LEFT_ALT LEFT_BRACE  &kp RIGHT_BRACE   &mt LEFT_GUI COLON  &mt LEFT_CONTROL DOUBLE_QUOTES
&kp PIPE  &kp EXCLAMATION     &kp AT        &kp HASH            &kp DOLLAR               &kp PERCENT    &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS         &kp LESS_THAN            &kp GREATER_THAN  &kp QUESTION        &kp AMPERSAND
&trans    &trans              &trans        &trans              &trans                   &trans         &trans  &trans                &trans                        &trans                   &trans            &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "N&Sym";
        };

        BLE {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                       &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &bt BT_CLR    &trans        &out OUT_TOG  &trans        &rgb_ug RGB_TOG                    &trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&trans  &out OUT_USB  &out OUT_BLE  &trans        &trans        &rgb_ug RGB_EFF                    &to 0   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans        &trans        &trans        &trans        &rgb_ug RGB_COLOR_HSB(54,68,76)    &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans        &trans        &trans        &trans        &trans                             &trans  &trans  &trans  &trans  &trans   &trans
            >;

            sensor-bindings = <&scroll_keypress LC(RIGHT) LC(LEFT)>;
            label = "BLE";
        };

        GamingWASD {
            bindings = <
&kp ESCAPE        &none           &none             &none         &none         &none     &none  &kp F5  &none  &kp F8  &none  &none  &none
&kp TAB           &none           &kp Q             &kp W         &kp E         &kp R     &none  &none   &none  &none   &none  &none  &none
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp A             &kp S         &kp D         &kp T     &to 5  &none   &none  &none   &none  &none  &none
&none             &kp NUMBER_1    &kp NUMBER_2      &kp NUMBER_3  &kp NUMBER_4  &kp N5    &to 0  &none   &none  &none   &none  &none  &none
&none             &none           &kp LEFT_CONTROL  &kp Z         &kp SPACE     &kp F     &none  &none   &none  &none   &none  &none
            >;

            label = "WASD";
        };

        LoL {
            bindings = <
&trans   &trans            &trans          &trans        &trans        &kp P        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp B    &kp NUMBER_1      &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB  &kp Q             &kp W           &kp E         &kp R         &kp T        &to 4   &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans            &kp S           &kp D         &kp F         &trans       &to 0   &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp C         &kp LEFT_ALT  &kp SPACE    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "QWER";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
